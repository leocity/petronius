      "container": "container",
      "kind": "line",
      "speaker": "gabriele",
      "portrait": {
        "class": "char_img_gabriele",
        "asset": "gabriele.png"
      },
      "text": "I kept it a secret for a long time. I knew Minerva very well, she is my sister.",
      "next": [
        {
          "to": "20"
        }
      ]
    },
    "20": {
      "id": "20",
      "container": "container",
      "kind": "line",
      "speaker": "sirio",
      "portrait": {
        "class": "char_img_sirio",
        "asset": "sirio_shocked.png"
      },
      "text": "What the fuck are you telling me?",
      "next": [
        {
          "to": "21"
        }
      ]
