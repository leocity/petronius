      "id": "24",
      "container": "container",
      "kind": "line",
      "speaker": "petronio",
      "portrait": {
        "class": "char_img_petronio",
        "asset": "petronio_dubbioso.png"
      },
      "text": "This is incredible news... It will surely change everything! Let's head back to the University to tell Yda and Roberto!",
