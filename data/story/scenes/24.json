      "id": "22",
      "container": "container",
      "kind": "line",
      "speaker": "petronio",
      "portrait": {
        "class": "char_img_petronio",
        "asset": "petronio_dubbioso.png"
      },
      "text": "Then why did you never say anything?",
      "next": [
        {
          "to": "23"
        }
      ]
    },
