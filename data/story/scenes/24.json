    "21": {
      "id": "21",
      "container": "container",
      "kind": "line",
      "speaker": "gabriele",
      "portrait": {
        "class": "char_img_gabriele",
        "asset": "gabriele.png"
      },
      "text": "Yes, kid, we were very close as children, even if very different. Then she became a great bitch, a person hungry for power, willing to do anything for it, including ruining our relationship by plotting behind everyone's back and lying shamelessly.",
      "next": [
        {
          "to": "22"
        }
      ]
